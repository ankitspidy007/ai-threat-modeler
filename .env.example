# Environment Configuration for AI Threat Modeler

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=5173

# API URL (used by frontend to connect to backend)
VITE_API_URL=http://127.0.0.1:8000

# Optional review-only local SLM. The model must already be available locally.
# Leave blank to use deterministic analysis and the semantic challenger only.
AEGIS_THREAT_LOCAL_SLM_MODEL=
AEGIS_THREAT_LOCAL_SLM_TASK=text2text-generation

# Optional local cross-encoder used after MiniLM/FAISS retrieval. The model
# must already exist in the Hugging Face cache; otherwise the deterministic
# security-feature reranker remains active.
AEGIS_THREAT_RERANKER_MODEL=
