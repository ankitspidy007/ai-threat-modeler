[
    {
        "threat_id": "AWS-S3-001",
        "threat_name": "Public S3 Bucket Exposure",
        "component": "Storage",
        "cloud_platform": [
            "AWS"
        ],
        "cloud_services": [
            "AWS S3"
        ],
        "stride_category": "Information Disclosure",
        "attack_vector": "Attacker discovers publicly accessible S3 bucket through enumeration or misconfiguration, accessing sensitive data without authentication.",
        "likelihood": "High",
        "impact": "Critical",
        "affected_cia": [
            "Confidentiality"
        ],
        "prerequisites": [
            "S3 bucket with public read permissions",
            "Sensitive data stored in bucket",
            "Lack of bucket policies restricting access"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Enable S3 Block Public Access at account and bucket level",
                "implementation": "AWS Console → S3 → Block Public Access Settings → Enable all options",
                "tools": [
                    "AWS S3",
                    "AWS Config",
                    "Terraform"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Implement least privilege bucket policies",
                "implementation": "Use IAM policies and bucket policies to restrict access to specific principals only",
                "tools": [
                    "AWS IAM",
                    "AWS S3 Bucket Policies"
                ]
            },
            {
                "control_type": "Detective",
                "description": "Enable S3 access logging and monitor for unauthorized access",
                "implementation": "Enable server access logging and send logs to CloudWatch for monitoring",
                "tools": [
                    "AWS CloudTrail",
                    "AWS CloudWatch",
                    "AWS Config"
                ]
            }
        ],
        "detection_methods": [
            {
                "method": "AWS Config Rules",
                "indicators": [
                    "s3-bucket-public-read-prohibited",
                    "s3-bucket-public-write-prohibited"
                ],
                "tools": [
                    "AWS Config",
                    "AWS Security Hub"
                ]
            },
            {
                "method": "CloudTrail Monitoring",
                "indicators": [
                    "GetBucketAcl events",
                    "PutBucketAcl events with public permissions"
                ],
                "tools": [
                    "AWS CloudTrail",
                    "AWS CloudWatch Logs Insights"
                ]
            }
        ],
        "references": {
            "cwe": [
                "CWE-732"
            ],
            "mitre_attack": [
                "T1530"
            ],
            "owasp": [
                "A01:2021"
            ],
            "nist": [
                "AC-3",
                "AC-6"
            ],
            "cis": [
                "CIS AWS 2.1.5"
            ],
            "external_links": [
                "https://docs.aws.amazon.com/AmazonS3/latest/userguide/access-control-block-public-access.html"
            ]
        },
        "real_world_examples": [
            {
                "incident": "Capital One Data Breach",
                "year": 2019,
                "impact": "106 million customer records exposed",
                "reference": "https://www.capitalone.com/digital/facts2019/"
            }
        ],
        "compliance_relevance": [
            "PCI-DSS",
            "HIPAA",
            "GDPR",
            "SOC2"
        ],
        "architecture_patterns": [
            "Microservices",
