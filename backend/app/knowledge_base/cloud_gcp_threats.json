        "threat_id": "GCP-STORAGE-001",
        "threat_name": "GCP Cloud Storage Bucket with allUsers Access",
        "component": "Storage",
        "cloud_platform": [
            "GCP"
        ],
        "cloud_services": [
            "GCP Cloud Storage"
        ],
        "stride_category": "Information Disclosure",
        "attack_vector": "Storage buckets with 'allUsers' or 'allAuthenticatedUsers' IAM bindings allow public access to sensitive data.",
        "likelihood": "High",
        "impact": "Critical",
        "affected_cia": [
            "Confidentiality"
        ],
        "prerequisites": [
            "Bucket with public IAM binding",
            "Sensitive data stored in bucket",
            "Uniform bucket-level access not enforced"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Remove public IAM bindings",
                "implementation": "Remove 'allUsers' and 'allAuthenticatedUsers' from bucket IAM policy",
                "tools": [
                    "GCP Cloud Storage",
                    "GCP IAM"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Enable uniform bucket-level access",
                "implementation": "Enforce uniform bucket-level access to use only IAM",
                "tools": [
                    "GCP Cloud Storage"
                ]
            },
            {
                "control_type": "Detective",
                "description": "Monitor bucket IAM policy changes",
                "implementation": "Set up Cloud Logging alerts for IAM policy modifications",
                "tools": [
                    "GCP Cloud Logging",
                    "GCP Security Command Center"
                ]
            }
        ],
        "detection_methods": [
            {
                "method": "Security Command Center",
                "indicators": [
                    "Public bucket ACL findings"
                ],
                "tools": [
                    "GCP Security Command Center"
                ]
            }
        ],
        "references": {
