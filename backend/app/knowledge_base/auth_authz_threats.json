    {
        "threat_id": "AUTH-003",
        "threat_name": "API Keys in URL Parameters",
        "component": "API",
        "cloud_platform": [
            "AWS",
            "Azure",
            "GCP",
            "On-Premise"
        ],
        "stride_category": "Information Disclosure",
        "attack_vector": "API keys passed in URL parameters are logged in server logs, browser history, and proxy logs, leading to exposure.",
        "likelihood": "High",
        "impact": "High",
        "affected_cia": [
            "Confidentiality"
        ],
        "prerequisites": [
            "API keys transmitted in query strings",
            "Server access logs enabled",
            "Third-party analytics or proxies"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Use Authorization header for API keys",
                "implementation": "Pass API keys in Authorization or X-API-Key headers",
                "tools": [
                    "API Gateway",
                    "Application Code"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Implement short-lived tokens",
                "implementation": "Use OAuth tokens instead of static API keys",
                "tools": [
                    "OAuth 2.0",
                    "JWT"
                ]
            },
            {
                "control_type": "Detective",
                "description": "Scan logs for exposed keys",
                "implementation": "Regularly scan logs and revoke exposed keys",
                "tools": [
                    "Log Analysis Tools"
                ]
            }
        ],
        "detection_methods": [
            {
                "method": "Log Analysis",
                "indicators": [
                    "API keys in access logs",
                    "Keys in URLs"
                ],
                "tools": [
                    "ELK Stack",
                    "Splunk"
                ]
            }
        ],
        "references": {
            "cwe": [
                "CWE-598"
            ],
            "mitre_attack": [
                "T1552.001"
            ],
            "owasp": [
                "API1:2023"
            ],
            "external_links": [
