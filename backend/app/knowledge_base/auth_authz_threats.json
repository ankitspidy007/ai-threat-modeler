[
    {
        "threat_id": "AUTH-001",
        "threat_name": "JWT Token Without Expiration",
        "component": "API",
        "cloud_platform": [
            "AWS",
            "Azure",
            "GCP",
            "On-Premise"
        ],
        "stride_category": "Spoofing",
        "attack_vector": "JWT tokens without expiration (exp claim) remain valid indefinitely, allowing long-term unauthorized access if stolen.",
        "likelihood": "High",
        "impact": "High",
        "affected_cia": [
            "Confidentiality",
            "Integrity"
        ],
        "prerequisites": [
            "JWT tokens issued without exp claim",
            "No token refresh mechanism",
            "Token theft or interception"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Always include expiration claim in JWT",
                "implementation": "Set short-lived tokens (15-60 minutes) with exp claim",
                "tools": [
                    "JWT Libraries",
                    "OAuth 2.0"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Implement token refresh mechanism",
                "implementation": "Use refresh tokens for obtaining new access tokens",
                "tools": [
                    "OAuth 2.0",
                    "OpenID Connect"
                ]
            },
            {
                "control_type": "Detective",
                "description": "Monitor token usage patterns",
                "implementation": "Alert on tokens used from multiple IPs or locations",
                "tools": [
                    "API Gateway",
                    "Application Logs"
                ]
            }
        ],
        "detection_methods": [
            {
                "method": "Token Analysis",
                "indicators": [
                    "Tokens without exp claim",
                    "Long-lived tokens"
                ],
                "tools": [
                    "jwt.io",
                    "Custom Validators"
                ]
            }
        ],
        "references": {
            "cwe": [
                "CWE-613"
            ],
            "mitre_attack": [
                "T1550.001"
            ],
            "owasp": [
                "A07:2021"
            ],
            "external_links": [
                "https://datatracker.ietf.org/doc/html/rfc7519"
            ]
        },
        "compliance_relevance": [
            "PCI-DSS",
            "SOC2"
        ],
        "architecture_patterns": [
            "API-first",
            "Microservices"
        ],
        "tags": [
            "authentication",
            "jwt",
            "session-management"
        ]
    },
    {
        "threat_id": "AUTH-002",
        "threat_name": "OAuth 2.0 Redirect URI Manipulation",
        "component": "API",
        "cloud_platform": [
            "AWS",
            "Azure",
            "GCP",
            "On-Premise"
        ],
        "stride_category": "Spoofing",
        "attack_vector": "Attacker manipulates redirect_uri parameter to steal authorization codes by redirecting to malicious site.",
        "likelihood": "Medium",
        "impact": "High",
        "affected_cia": [
            "Confidentiality"
        ],
        "prerequisites": [
            "Weak redirect URI validation",
            "Open redirector vulnerability",
            "Authorization code flow used"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Implement strict redirect URI validation",
                "implementation": "Use exact string matching for redirect URIs",
                "tools": [
                    "OAuth 2.0 Server"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Use PKCE for public clients",
                "implementation": "Implement Proof Key for Code Exchange (RFC 7636)",
                "tools": [
                    "OAuth 2.0 with PKCE"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Register all redirect URIs",
                "implementation": "Maintain whitelist of allowed redirect URIs per client",
                "tools": [
                    "OAuth 2.0 Server Configuration"
                ]
            }
        ],
        "detection_methods": [
            {
                "method": "Authorization Server Logs",
                "indicators": [
                    "Redirect URI mismatches",
                    "Unusual redirect patterns"
                ],
                "tools": [
                    "OAuth Server Logs"
                ]
            }
        ],
        "references": {
            "cwe": [
                "CWE-601"
            ],
            "mitre_attack": [
                "T1539"
            ],
            "capec": [
                "CAPEC-194"
            ],
            "owasp": [
                "A01:2021"
            ],
            "external_links": [
