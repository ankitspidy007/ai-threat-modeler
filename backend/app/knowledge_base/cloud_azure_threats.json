        "threat_id": "AZURE-BLOB-001",
        "threat_name": "Azure Blob Storage Anonymous Access",
        "component": "Storage",
        "cloud_platform": [
            "Azure"
        ],
        "cloud_services": [
            "Azure Blob Storage"
        ],
        "stride_category": "Information Disclosure",
        "attack_vector": "Storage containers configured with anonymous read access allow unauthorized data access without authentication.",
        "likelihood": "High",
        "impact": "Critical",
        "affected_cia": [
            "Confidentiality"
        ],
        "prerequisites": [
            "Container with public access level set to 'Blob' or 'Container'",
            "Sensitive data stored in publicly accessible container"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Disable anonymous access at storage account level",
                "implementation": "Set AllowBlobPublicAccess to false on storage account",
                "tools": [
                    "Azure Storage Account",
                    "Azure Policy"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Use Azure AD authentication",
                "implementation": "Implement RBAC with Azure AD for blob access",
                "tools": [
                    "Azure AD",
                    "Azure RBAC"
                ]
            },
            {
                "control_type": "Detective",
                "description": "Monitor storage access logs",
                "implementation": "Enable diagnostic logging and monitor for anonymous access",
                "tools": [
                    "Azure Monitor",
                    "Azure Storage Analytics"
                ]
            }
        ],
        "detection_methods": [
            {
                "method": "Azure Policy",
                "indicators": [
                    "Storage accounts allowing blob public access"
                ],
                "tools": [
                    "Azure Policy",
                    "Azure Security Center"
                ]
            }
        ],
        "references": {
            "cwe": [
                "CWE-732"
            ],
            "mitre_attack": [
                "T1530"
            ],
            "owasp": [
                "A01:2021"
            ],
            "nist": [
                "AC-3"
            ],
            "external_links": [
                "https://docs.microsoft.com/en-us/azure/storage/blobs/anonymous-read-access-prevent"
