[
    {
        "threat_id": "AI-001",
        "threat_name": "Prompt Injection Through Untrusted Content",
        "component": [
            "API",
            "Service",
            "WebClient",
            "ML Service"
        ],
        "cloud_platform": [
            "AWS",
            "Azure",
            "GCP",
            "On-Premise"
        ],
        "stride_category": "Tampering",
        "attack_vector": "Untrusted user or document content is passed directly into an LLM prompt, allowing hidden instructions to override system behavior and alter downstream decisions.",
        "likelihood": "High",
        "impact": "High",
        "affected_cia": [
            "Integrity",
            "Confidentiality"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "ml_pipeline",
                        "op": "==",
                        "value": true
                    },
                    {
                        "field": "input_validation",
                        "op": "==",
                        "value": false
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Separate system instructions from untrusted user or document content",
                "implementation": "Use structured prompt templates with explicit content boundaries and tool constraints",
                "tools": [
                    "Prompt Templates",
                    "Guardrails"
                ]
            }
        ],
        "references": {
            "owasp": [
                "LLM01"
            ],
            "cwe": [
                "CWE-74"
            ]
        }
    },
    {
        "threat_id": "AI-002",
        "threat_name": "Sensitive Data Leakage Through LLM Responses",
        "component": [
            "API",
            "Service",
            "ML Service",
            "Database"
        ],
        "cloud_platform": [
            "AWS",
            "Azure",
            "GCP",
            "On-Premise"
        ],
        "stride_category": "Information Disclosure",
        "attack_vector": "The application sends sensitive records to an LLM or returns model output without redaction, exposing credentials, PII, or proprietary content.",
        "likelihood": "High",
        "impact": "Critical",
        "affected_cia": [
            "Confidentiality"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "ml_pipeline",
                        "op": "==",
                        "value": true
                    },
                    {
                        "field": "data_sensitivity",
                        "op": "in",
                        "value": [
                            "pii",
                            "financial",
                            "credentials",
                            "phi"
                        ]
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Apply data minimization and redaction before model calls",
                "implementation": "Strip secrets, PII, and regulated data before passing context to LLMs",
                "tools": [
                    "DLP",
                    "PII Redaction"
                ]
            }
        ],
        "references": {
            "owasp": [
                "LLM02"
            ],
            "cwe": [
                "CWE-200"
            ]
        }
    },
    {
        "threat_id": "AI-003",
        "threat_name": "Insecure Vector Store Exposure",
        "component": [
            "Database",
            "Object Storage",
            "ML Service",
            "Service"
        ],
        "cloud_platform": [
            "AWS",
            "Azure",
            "GCP",
            "On-Premise"
        ],
        "stride_category": "Information Disclosure",
        "attack_vector": "Embeddings and retrieved context are stored in a vector database without proper access control, exposing source documents and semantic search content.",
        "likelihood": "Medium",
        "impact": "High",
        "affected_cia": [
            "Confidentiality"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Protect vector indexes with the same controls as source data",
                "implementation": "Require authentication, encryption, and tenant-aware isolation for vector storage",
                "tools": [
                    "RBAC",
                    "Encryption"
                ]
            }
        ],
        "references": {
            "cwe": [
                "CWE-284"
            ]
        }
    },
    {
