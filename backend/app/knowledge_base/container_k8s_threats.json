    {
        "threat_id": "K8S-003",
        "threat_name": "Secrets Stored as Environment Variables",
        "component": [
            "API",
            "Database",
            "Queue",
            "WebClient",
            "Service",
            "Container"
        ],
        "cloud_platform": [
            "AWS",
            "Azure",
            "GCP",
            "On-Premise"
        ],
        "cloud_services": [
            "AWS EKS",
            "Azure AKS",
            "GCP GKE"
        ],
        "stride_category": "Information Disclosure",
        "attack_vector": "Secrets exposed as environment variables can be accessed through container inspection or process listing.",
        "likelihood": "High",
        "impact": "High",
        "affected_cia": [
            "Confidentiality"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "secrets_in_env",
                        "op": "==",
                        "value": true
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "prerequisites": [
            "Secrets mounted as environment variables",
            "Container access or compromise",
            "Lack of secrets encryption"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Use Kubernetes Secrets with volume mounts",
                "implementation": "Mount secrets as files instead of environment variables",
                "tools": [
                    "Kubernetes Secrets"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Use external secrets management",
                "implementation": "Integrate with AWS Secrets Manager, Azure Key Vault, or HashiCorp Vault",
                "tools": [
                    "External Secrets Operator",
                    "Secrets Store CSI Driver"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Enable secrets encryption at rest",
                "implementation": "Configure encryption provider for etcd",
                "tools": [
                    "Kubernetes Encryption at Rest"
                ]
            }
        ],
        "detection_methods": [
            {
                "method": "Static Analysis",
                "indicators": [
                    "Environment variables containing secrets"
                ],
                "tools": [
                    "kube-score",
                    "Checkov"
                ]
            }
        ],
        "references": {
            "cwe": [
                "CWE-200"
            ],
            "mitre_attack": [
                "T1552.001"
            ],
            "cis": [
                "CIS Kubernetes 5.4.1"
            ],
            "external_links": [
                "https://kubernetes.io/docs/concepts/configuration/secret/"
            ]
        },
        "compliance_relevance": [
            "PCI-DSS",
            "SOC2"
        ],
        "architecture_patterns": [
            "Container-based",
            "Microservices"
        ],
        "tags": [
            "kubernetes",
            "secrets-management",
            "credential-exposure"
        ]
