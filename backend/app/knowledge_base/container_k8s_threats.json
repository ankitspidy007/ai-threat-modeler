[
    {
        "threat_id": "K8S-001",
        "threat_name": "Container Running as Root",
        "component": [
            "API",
            "Database",
            "Queue",
            "WebClient",
            "Service",
            "Container"
        ],
        "cloud_platform": [
            "AWS",
            "Azure",
            "GCP",
            "On-Premise"
        ],
        "cloud_services": [
            "AWS EKS",
            "Azure AKS",
            "GCP GKE"
        ],
        "stride_category": "Elevation of Privilege",
        "attack_vector": "Containers running with root privileges can escape to host system if container runtime vulnerability is exploited.",
        "likelihood": "High",
        "impact": "Critical",
        "affected_cia": [
            "Confidentiality",
            "Integrity",
            "Availability"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "privileged_container",
                        "op": "==",
                        "value": true
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "prerequisites": [
            "Container configured to run as root (UID 0)",
            "No security context constraints",
            "Container runtime vulnerability"
        ],
        "mitigations": [
            {
                "control_type": "Preventive",
                "description": "Run containers as non-root user",
                "implementation": "Set runAsNonRoot: true in pod security context",
                "tools": [
                    "Kubernetes Pod Security"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Use Pod Security Standards",
                "implementation": "Enforce 'restricted' pod security standard",
                "tools": [
                    "Kubernetes Pod Security Admission"
                ]
            },
            {
                "control_type": "Preventive",
                "description": "Drop unnecessary capabilities",
                "implementation": "Remove all capabilities and add only required ones",
                "tools": [
                    "Kubernetes Security Context"
                ]
            }
        ],
        "detection_methods": [
            {
                "method": "Admission Controller",
                "indicators": [
                    "Pods running as root"
                ],
                "tools": [
                    "OPA Gatekeeper",
                    "Kyverno",
                    "Pod Security Admission"
                ]
            }
        ],
        "references": {
            "cwe": [
                "CWE-250"
            ],
            "mitre_attack": [
                "T1611"
            ],
            "capec": [
                "CAPEC-233"
            ],
            "cis": [
                "CIS Kubernetes 5.2.6"
            ],
            "external_links": [
                "https://kubernetes.io/docs/tasks/configure-pod-container/security-context/"
            ]
        },
        "compliance_relevance": [
            "PCI-DSS",
            "SOC2"
        ],
        "architecture_patterns": [
            "Container-based",
            "Microservices"
        ],
        "tags": [
            "kubernetes",
            "container-security",
            "privilege-escalation"
        ]
    },
