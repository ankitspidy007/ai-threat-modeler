    {
        "id": "DB-006",
        "category": "Elevation of Privilege",
        "resource_type": [
            "Database",
            "DB"
        ],
        "detection": {
            "logic": {
                "operator": "OR",
                "conditions": [
                    {
                        "field": "least_privilege",
                        "op": "==",
                        "value": false
                    },
                    {
                        "field": "shared_accounts",
                        "op": "==",
                        "value": true
                    }
                ]
            },
            "auto_detectable": false,
            "confidence": "medium"
        },
        "threat": {
            "title": "Excessive Database Privileges",
            "description": "Application uses a database account with excessive privileges (e.g., DBA/root access). SQL injection or compromised credentials grant full database control."
        },
        "risk": {
            "severity": "High",
            "likelihood": "Medium",
            "impact": "High",
            "risk_score": 78.0,
            "affected_assets": [
                "Database Schema",
                "All Tables"
            ],
            "business_impact": [
                "Data Manipulation",
                "Schema Destruction"
            ]
        },
        "mitigation": {
            "primary": "Apply least privilege: create dedicated accounts with minimal permissions (SELECT only for read services).",
            "defense_in_depth": [
                "Row-level security",
                "Schema-level isolation",
                "Stored procedure restrictions"
            ],
            "verification": "Audit database user permissions against application requirements."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A01:2021-Broken Access Control"
            ],
            "cwe": [
                "CWE-250"
            ],
            "nist_800_53": [
                "AC-6",
                "AC-3"
            ]
        },
        "tags": [
            "database",
            "privileges",
            "least-privilege"
        ]
    },
    {
        "id": "DB-007",
        "category": "Tampering",
        "resource_type": [
            "Database",
            "DB",
            "Cache"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "type",
                        "op": "in",
                        "value": [
                            "Cache",
                            "Redis",
                            "Memcached"
                        ]
                    },
                    {
                        "field": "auth_type",
                        "op": "==",
                        "value": "none"
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "threat": {
            "title": "Unauthenticated Cache Access",
            "description": "Cache layer (Redis/Memcached) has no authentication enabled, allowing any network-accessible client to read/modify cached data including session tokens."
        },
        "risk": {
            "severity": "Critical",
            "likelihood": "High",
            "impact": "High",
            "risk_score": 88.0,
            "affected_assets": [
                "Session Data",
                "Cached Credentials"
            ],
            "business_impact": [
                "Session Hijacking",
                "Data Tampering"
            ]
        },
        "mitigation": {
            "primary": "Enable authentication (Redis AUTH, ACLs). Bind to private network interfaces only.",
            "defense_in_depth": [
                "TLS encryption for cache connections",
                "Network segmentation",
                "Access logging"
            ],
            "verification": "Verify cache requires authentication and is not exposed to public networks."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A07:2021-Identification and Authentication Failures"
            ],
            "cwe": [
                "CWE-306"
            ],
            "nist_800_53": [
                "IA-2",
                "SC-7"
            ]
        },
        "tags": [
            "database",
            "cache",
            "redis",
            "authentication"
        ]
    },
    {
        "id": "DB-008",
        "category": "Denial of Service",
        "resource_type": [
            "Database",
            "DB"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "type",
                        "op": "in",
                        "value": [
                            "Database",
                            "DB"
                        ]
                    },
                    {
                        "field": "connection_pooling",
                        "op": "==",
                        "value": false
                    }
                ]
            },
            "auto_detectable": false,
            "confidence": "medium"
        },
        "threat": {
            "title": "Database Connection Exhaustion",
            "description": "No connection pooling or connection limits configured. Attackers can exhaust database connections causing service-wide outages."
        },
        "risk": {
            "severity": "Medium",
            "likelihood": "Medium",
            "impact": "High",
            "risk_score": 62.0,
            "affected_assets": [
                "Database Availability"
            ],
            "business_impact": [
                "Service Outage",
                "Cascading Failures"
            ]
        },
        "mitigation": {
            "primary": "Implement connection pooling (PgBouncer, HikariCP). Set maximum connection limits.",
            "defense_in_depth": [
                "Connection timeout enforcement",
                "Query timeout limits",
                "Database health monitoring"
            ],
            "verification": "Load test to verify connection pool behavior under stress."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A05:2021-Security Misconfiguration"
            ],
            "cwe": [
                "CWE-400"
            ],
            "nist_800_53": [
                "SC-5",
                "SC-6"
            ]
        },
        "tags": [
            "database",
            "availability",
            "connection-pooling"
        ]
    }
