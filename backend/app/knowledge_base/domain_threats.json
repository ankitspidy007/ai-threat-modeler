[
    {
        "id": "IOT-001",
        "category": "Tampering",
        "resource_type": [
            "IoT Device",
            "Queue"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "ota_updates",
                        "op": "==",
                        "value": true
                    },
                    {
                        "field": "code_signing",
                        "op": "!=",
                        "value": true
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "threat": {
            "title": "IoT Firmware Tampering Risk",
            "description": "Over-the-air (OTA) firmware updates are enabled without code signing, allowing attackers to push malicious firmware to IoT devices."
        },
        "risk": {
            "severity": "Critical",
            "likelihood": "Medium",
            "impact": "High",
            "risk_score": 82.5,
            "affected_assets": [
                "IoT Devices",
                "Patient Data"
            ],
            "business_impact": [
                "Device Compromise",
                "Patient Safety"
            ]
        },
        "mitigation": {
            "primary": "Implement code signing for all firmware updates with secure key management.",
            "defense_in_depth": [
                "Secure boot",
                "Device attestation",
                "Rollback protection"
            ],
            "verification": "Verify firmware signature validation on devices."
        },
        "references": [
            "OWASP IoT Top 10",
            "NIST IoT Security"
        ],
        "tags": [
            "iot",
            "firmware",
            "medical-device"
        ]
    },
    {
        "id": "IOT-002",
        "category": "Spoofing",
        "resource_type": [
            "IoT Device"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "is_iot_device",
                        "op": "==",
                        "value": true
                    },
                    {
                        "field": "device_authentication",
                        "op": "!=",
                        "value": true
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "medium"
        },
        "threat": {
            "title": "Rogue IoT Device Connection",
            "description": "IoT devices lack proper authentication, allowing rogue devices to connect and inject false medical data."
        },
        "risk": {
            "severity": "High",
            "likelihood": "Medium",
            "impact": "High",
            "risk_score": 75.0,
            "affected_assets": [
                "Medical Data",
                "Patient Safety"
            ],
            "business_impact": [
                "Incorrect Diagnosis",
                "Patient Harm"
            ]
        },
        "mitigation": {
            "primary": "Implement device certificates (X.509) for mutual authentication.",
            "defense_in_depth": [
                "Device whitelisting",
                "Network segmentation"
            ],
            "verification": "Test with unauthorized device connection attempts."
        },
        "references": [
            "FDA Medical Device Security"
        ],
        "tags": [
            "iot",
            "authentication",
            "medical-device"
        ]
    },
