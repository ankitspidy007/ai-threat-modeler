{
    "PCI_DSS": {
        "name": "Payment Card Industry Data Security Standard",
        "version": "4.0",
        "requirements": {
            "6.5.1": {
                "title": "Injection flaws",
                "threats": [
                    "SQL_INJECTION",
                    "NOSQL_INJECTION",
                    "XSS"
                ],
                "description": "Validate input to prevent injection attacks"
            },
            "6.5.3": {
                "title": "Insecure cryptographic storage",
                "threats": [
                    "CRYPTOGRAPHIC_FAILURES"
                ],
                "description": "Protect stored cardholder data"
            },
            "6.5.10": {
                "title": "Broken authentication and session management",
                "threats": [
                    "JWT_ISSUES",
                    "BROKEN_ACCESS_CONTROL"
                ],
                "description": "Implement proper authentication"
            },
            "8.2.1": {
                "title": "Strong authentication",
                "threats": [
                    "BROKEN_ACCESS_CONTROL"
                ],
                "description": "Use strong authentication mechanisms"
            },
            "8.3": {
                "title": "Secure authentication",
                "threats": [
                    "JWT_ISSUES",
                    "EXPOSED_CREDENTIALS"
                ],
                "description": "Secure all authentication credentials"
            }
        }
    },
    "HIPAA": {
        "name": "Health Insurance Portability and Accountability Act",
        "security_rule": {
            "164.308(a)(1)": {
                "title": "Security Management Process",
                "threats": [
                    "BROKEN_ACCESS_CONTROL",
                    "CRYPTOGRAPHIC_FAILURES"
                ],
                "description": "Implement policies to prevent unauthorized access to ePHI"
            },
            "164.308(a)(3)": {
                "title": "Workforce Security",
                "threats": [
                    "BROKEN_ACCESS_CONTROL"
                ],
                "description": "Ensure workforce members have appropriate access"
            },
            "164.312(a)(1)": {
                "title": "Access Control",
                "threats": [
                    "BROKEN_ACCESS_CONTROL",
                    "JWT_ISSUES"
                ],
                "description": "Implement technical policies for access control"
            },
            "164.312(e)(1)": {
                "title": "Transmission Security",
                "threats": [
                    "CRYPTOGRAPHIC_FAILURES",
                    "SSRF"
                ],
                "description": "Implement technical security measures for ePHI transmission"
            }
        }
    },
    "GDPR": {
